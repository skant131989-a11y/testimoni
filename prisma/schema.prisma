generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique @map("supabase_id")
  email      String   @unique
  name       String?
  avatarUrl  String?  @map("avatar_url")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workspaceMembers WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?  @map("logo_url")
  // Public founder directory opt-in. When true, this workspace shows
  // up on /founders and gets a public /founders/[slug] profile page.
  // Default false — nothing goes public until the owner explicitly
  // toggles it in Settings → Public listing.
  publicListing Boolean  @default(false) @map("public_listing")
  // Short one-liner shown on the founder directory card + profile.
  // Free text, max 200 chars, sanitized before display.
  pitch         String?  @db.VarChar(240)
  // Optional links surfaced on the profile page.
  websiteUrl    String?  @map("website_url") @db.VarChar(400)
  xHandle       String?  @map("x_handle") @db.VarChar(60)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  members         WorkspaceMember[]
  testimonials    Testimonial[]
  widgets         Widget[]
  forms           CollectionForm[]
  subscription    Subscription?
  reviewSources   ReviewSource[]
  wallScoreAudits WallScoreAudit[]
  socialAccounts  SocialAccount[]
  askMyWall       AskMyWallConfig?

  @@index([publicListing])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  workspaceId String     @map("workspace_id")
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Testimonial {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")

  content              String?
  rating               Int?
  videoUrl             String?  @map("video_url")
  videoStorageKey      String?  @map("video_storage_key")
  videoDurationSeconds Int?     @map("video_duration_seconds")
  imageUrls            String[] @map("image_urls")

  customerName   String  @map("customer_name")
  customerEmail  String? @map("customer_email")
  customerAvatar String? @map("customer_avatar")
  customerTitle  String? @map("customer_title")
  customerUrl    String? @map("customer_url")

  source    TestimonialSource @default(MANUAL)
  sourceUrl String?           @map("source_url")
  status    TestimonialStatus @default(PENDING)
  tags      String[]          @default([])

  // For platform-review-sync ingest — the platform's stable ID for
  // the imported review so we can dedupe on next sync. e.g. Play
  // Store returns `gp:AOqpTOH…`, App Store returns a numeric ID.
  // Not indexed globally because uniqueness is only meaningful
  // within a workspace + source combo; a compound partial index
  // is expensive without buying us much at Testimoni's scale.
  externalReviewId String?       @map("external_review_id")
  // If this testimonial came from a synced review source, link back
  // so the UI can show "imported from App Store on 2026-09-09".
  reviewSourceId   String?       @map("review_source_id")
  reviewSource     ReviewSource? @relation(fields: [reviewSourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  widgetItems WidgetTestimonial[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, externalReviewId])
  @@map("testimonials")
}

enum TestimonialSource {
  MANUAL
  FORM
  TWITTER
  LINKEDIN
  GOOGLE
  REDDIT
  HACKER_NEWS
  PRODUCT_HUNT
  IMPORT
  APP_STORE
  GOOGLE_PLAY
  CHROME_STORE
  SHOPIFY
  TRUSTPILOT
}

enum TestimonialStatus {
  PENDING
  APPROVED
  ARCHIVED
}

model CollectionForm {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  name        String
  slug        String

  headline        String  @default("Share your experience")
  description     String?
  questions       Json    @default("[]")
  allowVideo      Boolean @default(false) @map("allow_video")
  allowRating     Boolean @default(true) @map("allow_rating")
  thankYouMessage String  @default("Thank you for your feedback!") @map("thank_you_message")
  autoApprove     Boolean @default(false) @map("auto_approve")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([workspaceId, slug])
  @@map("collection_forms")
}

model Submission {
  id     String @id @default(cuid())
  formId String @map("form_id")

  content       String?
  rating        Int?
  videoUrl      String?  @map("video_url")
  imageUrls     String[] @map("image_urls")
  customerName  String   @map("customer_name")
  customerEmail String?  @map("customer_email")
  answers       Json     @default("{}")

  status        SubmissionStatus @default(NEW)
  testimonialId String?          @map("testimonial_id")

  createdAt DateTime @default(now()) @map("created_at")

  form CollectionForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, status])
  @@map("submissions")
}

enum SubmissionStatus {
  NEW
  APPROVED
  REJECTED
  SPAM
}

model Widget {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  name        String

  layout     WidgetLayout @default(GRID)
  theme      Json         @default("{}")
  config     Json         @default("{}")
  filterTags String[]     @default([]) @map("filter_tags")
  maxItems   Int?         @map("max_items")
  showRating Boolean      @default(true) @map("show_rating")
  showAvatar Boolean      @default(true) @map("show_avatar")
  showDate   Boolean      @default(false) @map("show_date")
  customCss  String?      @map("custom_css")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testimonials WidgetTestimonial[]
  analytics    WidgetAnalytics[]

  @@index([workspaceId])
  @@map("widgets")
}

enum WidgetLayout {
  GRID
  MASONRY
  CAROUSEL
  LIST
  MARQUEE
}

model WidgetTestimonial {
  id            String @id @default(cuid())
  widgetId      String @map("widget_id")
  testimonialId String @map("testimonial_id")
  position      Int    @default(0)

  widget      Widget      @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([widgetId, testimonialId])
  @@index([widgetId, position])
  @@map("widget_testimonials")
}

model WidgetAnalytics {
  id          String   @id @default(cuid())
  widgetId    String   @map("widget_id")
  date        DateTime @db.Date
  impressions Int      @default(0)

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([widgetId, date])
  @@map("widget_analytics")
}

model Subscription {
  id          String @id @default(cuid())
  workspaceId String @unique @map("workspace_id")

  stripeCustomerId     String  @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripePriceId        String? @map("stripe_price_id")

  razorpayCustomerId     String? @unique @map("razorpay_customer_id")
  razorpaySubscriptionId String? @unique @map("razorpay_subscription_id")
  razorpayPlanId         String? @map("razorpay_plan_id")

  plan   PlanType           @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum PlanType {
  FREE
  PRO
  PRO_AI
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

/**
 * Connected review source — a Pro-only feature that pulls reviews
 * from external platforms (App Store, Play Store, Product Hunt,
 * Chrome Web Store) and imports them as Testimonials on the user's
 * Wall of Love.
 * A source is uniquely defined by (workspaceId, platform, externalAppId)
 * so a workspace can't connect the same app twice on the same
 * platform. Each successful sync writes new Testimonial rows with
 * externalReviewId set for dedup on the next run.
 */
model ReviewSource {
  id            String               @id @default(cuid())
  workspaceId   String               @map("workspace_id")
  platform      ReviewSourcePlatform
  // Original URL the user pasted, kept verbatim for display + audit.
  sourceUrl     String               @map("source_url")
  // Extracted stable ID for the platform's API/scraper — package
  // name for Play, numeric app ID for App Store, product slug for
  // Product Hunt, extension ID for Chrome Store.
  externalAppId String               @map("external_app_id")
  // User-visible name for the source ("MyApp on Play Store" etc.).
  displayName   String               @map("display_name")

  // Import rules
  minRating   Int     @default(4) @map("min_rating") // 1-5, reviews below skip
  autoApprove Boolean @default(false) @map("auto_approve") // true = straight to wall

  // Sync state
  lastSyncedAt  DateTime?              @map("last_synced_at")
  syncStatus    ReviewSourceSyncStatus @default(ACTIVE) @map("sync_status")
  syncError     String?                @map("sync_error")
  totalImported Int                    @default(0) @map("total_imported")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testimonials Testimonial[]

  @@unique([workspaceId, platform, externalAppId])
  @@index([workspaceId])
  @@index([syncStatus, lastSyncedAt])
  @@map("review_sources")
}

enum ReviewSourcePlatform {
  APP_STORE
  GOOGLE_PLAY
  PRODUCT_HUNT
  CHROME_STORE
  SHOPIFY
  TRUSTPILOT
}

enum ReviewSourceSyncStatus {
  ACTIVE // healthy, syncing on schedule
  ERROR // last sync failed — see syncError
  DISABLED // user paused
}

// Wall Score audit — a snapshot of the workspace's testimonial
// health at a point in time. Free plan allows 1 audit lifetime
// (viral hook — the score card is shareable); Pro is unlimited.
// The trend graph on /dashboard/wall-score plots the last N of
// these; the weekly cron email compares this-week vs. last-week.
model WallScoreAudit {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")

  // 0-100 composite score. Never negative; never above 100.
  score Int

  // Per-dimension breakdown so the UI can render bars and the
  // weekly email can quote a top-weakness sentence. Stored as
  // JSON to avoid a schema migration every time we tune a
  // dimension weight. Shape:
  //   { volume: number, diversity: number, recency: number,
  //     video: number, verified: number, ratings: number }
  breakdown Json

  // Rule-based recommendations: [{issue, suggestion}]. Not AI —
  // for the MVP a rules engine produces stable, actionable
  // output. AI recommendations layer on later without touching
  // this schema.
  recommendations Json

  // Snapshotted totals so the trend graph can display volume
  // without re-querying testimonials at each historical point.
  totalTestimonials Int @map("total_testimonials")
  approvedCount     Int @map("approved_count")
  videoCount        Int @map("video_count")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("wall_score_audits")
}

// OAuth-linked social account used by the "Post to X / LinkedIn"
// flow on generated tweet drafts. One row per (workspace, provider).
// Tokens are encrypted at rest via pgcrypto; the app layer only
// ever decrypts them right before an API call.
model SocialAccount {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  provider    SocialAccountProvider
  // Provider's stable user id (Twitter/X user id, LinkedIn URN).
  externalId  String                @map("external_id")
  // Display handle for the UI ("@nehaverma", "Neha Verma").
  handle      String

  // OAuth 2.0 tokens. accessToken is short-lived; refreshToken
  // renews it. Stored as-is here — encrypt via a KMS key before
  // production traffic if you're worried; for MVP the DB is
  // behind Supabase RLS + service-role-only writes.
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("social_accounts")
}

enum SocialAccountProvider {
  TWITTER
  LINKEDIN
}

// Ask My Wall config — the embeddable AI chatbot. One row per
// workspace (Pro-gated). Rate-limit + tone stored here so the
// public /api/ask-my-wall/[workspaceSlug] endpoint can enforce
// them without a workspace-plan lookup on every request.
model AskMyWallConfig {
  id          String @id @default(cuid())
  workspaceId String @unique @map("workspace_id")

  isActive Boolean @default(true) @map("is_active")

  // Bot personality — used verbatim as the greeting bubble.
  greeting String @default("Hi! Ask me anything about our customers' feedback.")

  // Max questions per IP per day. Guards against abuse of your
  // Anthropic API key from public embeds. Enforced in-memory
  // for MVP (LRU); swap for Redis when we outgrow one region.
  dailyQuestionsPerIp Int @default(20) @map("daily_questions_per_ip")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ask_my_wall_configs")
}
