{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/wall-score-weekly",
      "schedule": "37 2 * * 1"
    },
    {
      "path": "/api/cron/expire-grants",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/weekly-mentions",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/cron/weekly-mentions",
      "schedule": "20 16 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/embed/collect.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
