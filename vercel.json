{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "syd1"
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/daily-outreach/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/find-prospects/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/watch-recheck/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/embed/collect.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
